def main():
    ap = argparse.ArgumentParser(prog="lumos", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--vault", type=Path, default=None,
                    help="vault 路徑 (預設自動找 docs/*-knowledge)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    d = sub.add_parser("doctor", help="圖譜健康巡檢")
    d.add_argument("--strict", action="store_true", help="有 finding 即 exit 1 (CI 用)")
    d.add_argument("--ci", action="store_true", help="CI 模式 = --strict + 無色彩")
    d.add_argument("--suggest", action="store_true",
                   help="orphan Verification 附推薦掛載 Systems(從正文連結/plan_refs/feature 推斷,供人確認)")

    for name, hlp in (("links", "連出的節點"), ("backlinks", "連入的節點")):
        p = sub.add_parser(name, help=hlp)
        p.add_argument("note")

    p = sub.add_parser("context", help="節點+鄰居壓縮索引")
    p.add_argument("note")
    p.add_argument("--brief", action="store_true", help="壓縮版(meta+summary 首兩行+鄰居名單)")
    p.add_argument("--recommend", action="store_true", help="尾列相關節點推薦(圖分×詞彙融合;dormant v1)")
    p.add_argument("--top", type=int, default=8, dest="ctx_top", help="--recommend 輸出上限")
    p.add_argument("--min-score", type=float, default=0.20, dest="ctx_min", help="--recommend 分數底線")
    p.add_argument("--json", action="store_true", dest="ctx_json", help="--recommend JSON 輸出")

    p = sub.add_parser("show", help="節點完整內容(frontmatter+body;--body-only 略 frontmatter)")
    p.add_argument("note")  # 派發組共用 args.note(9656 組硬編碼取用;嚴禁命名 node)
    p.add_argument("--body-only", action="store_true", dest="body_only", help="只印 body(剝離開頭 frontmatter)")

    p = sub.add_parser("contracts", help="合約登記簿 ★INVARIANT★/★DEBT★(全 vault 或單節點)")
    p.add_argument("note", nargs="?")

    p = sub.add_parser("lint", help="單檔快檢:寫完一個節點立刻自驗標籤/格式(比 doctor 快,只看這篇)")
    p.add_argument("note")




    g = sub.add_parser("guard", help="合約守衛 scaffold(對談驅動):列出未綁 / 套範本產 stub / 綁定")
    gsub = g.add_subparsers(dest="gcmd", required=True)
    gl = gsub.add_parser("list", help="列 ★INVARIANT★ 綁定狀態(real/dangling/fake/naked)")
    gl.add_argument("--unbound", action="store_true", help="只列未綁(懸空/偽證據/裸)")
    gs = gsub.add_parser("scaffold", help="套範本產測試 stub(預設紅燈,斷言留 TODO)")
    gs.add_argument("--node", required=True, help="守衛的 Systems 節點")
    gs.add_argument("--invariant", required=True, help="KEY 行子字串(定位該合約)")
    gs.add_argument("--method", required=True, help="測試方法名(= [test:] 認領名)")
    gs.add_argument("--type", required=True, choices=list(GUARD_TYPES))
    gs.add_argument("--claim", required=True, help="向人確認過的可測斷言(白話,寫進 stub 註解)")
    gs.add_argument("--out", help="測試專案目錄(預設自動偵測 *Tests / *IntegrationTests)")
    gs.add_argument("--template", help="範本路徑(預設 .lumos/guard-templates/<type>.tmpl)")
    gs.add_argument("--class", dest="klass", help="測試類別名(預設 <method>Tests)")
    gs.add_argument("--platform", help="多平台 config 下指定平台(決定 root/profile/範本落點);"
                                       "省略且單一平台時自動選,多平台則必填")
    gb = gsub.add_parser("bind", help="把 [test:方法] 綁回 KEY 行(寫後自驗)")
    gb.add_argument("node")
    gb.add_argument("invariant", help="KEY 行子字串")
    gb.add_argument("method")
    gb.add_argument("--platform", help="多平台 config 下寫成 [test:平台:方法](method 維持識別字)")
    ga = gsub.add_parser("audit", help="留痕 [audit:模型/日期]:合法性經無脈絡獨立 agent 審計過(maker≠checker)")
    ga.add_argument("node")
    ga.add_argument("invariant", help="KEY 行子字串")
    ga.add_argument("--model", default="sonnet", help="審計用的模型(預設 sonnet — 刻意較弱,不腦補補洞)")
    ga.add_argument("--date", help="審計日期 YYYY-MM-DD(預設今天)")
    gt = gsub.add_parser("trace", help="合約→守衛測試→Verification 證據鏈(reverse:爆炸半徑可查)")
    gt.add_argument("node", nargs="?", help="限單節點(預設全 vault)")
    gka = gsub.add_parser("kill-add", help="宣告壞法配方(kill_recipes+[kill:recipes],同檔原子寫)")
    gka.add_argument("node")
    gka.add_argument("invariant", help="KEY 行子字串")
    gka.add_argument("--file", required=True, help="要弄壞的檔(相對配方平台 root)")
    gka.add_argument("--old", required=True, help="literal 原文(須唯一命中)")
    gka.add_argument("--new", required=True, help="壞版本")
    gka.add_argument("--test", help="綁定測試名(缺省=KEY 行唯一 [test:] ref)")
    gka.add_argument("--platform", dest="gk_platform", help="配方所屬平台(多平台 config)")
    gka.add_argument("--note", default="", help="業務上壞了什麼(人話)")
    gk = gsub.add_parser("kill", help="跑殺傷力驗證:worktree 隔離→baseline 綠→套壞法→綁定測試必須翻紅")
    gk.add_argument("node")
    gk.add_argument("invariant", nargs="?", help="限某合約(KEY 行子字串;預設全部配方)")
    gk.add_argument("--platform", dest="gk_platform", help="覆蓋配方平台")
    gk.add_argument("--json", dest="gk_json", action="store_true", help="輸出 JSON manifest")
    gk.add_argument("--keep-worktree", action="store_true", help="保留沙盒現場(除錯)")



    p = sub.add_parser("sync-verified-by", help="補 Check 3 漏寫的 verified_by(dry-run 預設)")
    p.add_argument("--apply", action="store_true", help="真寫入(否則 dry-run 只列)")

    p = sub.add_parser("search", help="全文搜尋(frontmatter+body);取代 obsidian search")
    p.add_argument("term")
    p.add_argument("--path", dest="path_prefix", help="限資料夾前綴(如 Systems)")
    p.add_argument("--regex", action="store_true", help="term 當正則(預設 substring 大小寫不敏感)")
    p.add_argument("--files-only", action="store_true", help="只列檔名+命中數")
    p.add_argument("--code", action="store_true", help="含 code block(預設排除,對齊 doctor)")
    p.add_argument("--ranked", action="store_true", help="BM25F 相關性排序(2026-07-11 起已是預設,旗標保留相容)")
    p.add_argument("--legacy", action="store_true", dest="search_legacy",
                   help="舊行為:字母序+全量輸出(轉正前預設;--regex 自動走此路)")
    p.add_argument("--top", type=int, default=0, help="相關性排序輸出上限(0=全量,預設;圖譜先行不靜默截斷)")
    p.add_argument("--json", dest="search_json", action="store_true", help="相關性排序 JSON manifest")
    p.add_argument("--include-superseded", dest="include_superseded", action="store_true",
                   help="含已作廢(superseded)節點(預設排除;真遺忘,不影響 stale)")

    p = sub.add_parser("map", help="鄰域樹狀展開")
    p.add_argument("note")
    p.add_argument("--depth", type=int, default=2)

    p = sub.add_parser("decisions", help="讀取 ADR 決策")
    p.add_argument("note", nargs="?")
    p.add_argument("--superseded", action="store_true", help="全 vault 掃被推翻的決策")

    p = sub.add_parser("stale", help="stale 驗證 / 條件命中掃描 / --candidate 列待覆查清單")
    p.add_argument("--match", help="掃 valid_under/revalidate_when 含此字串的驗證")
    p.add_argument("--candidate", action="store_true",
                   help="(須配 --match)聚焦:活躍+revalidate_when 提到該關鍵字、排 Archive — "
                        "「改 X 流程該重驗哪幾篇」;比純 --match 窄(只看 revalidate_when 不看 valid_under)")
    p.add_argument("--legacy", dest="stale_legacy", action="store_true",
                   help="bare 模式保舊字母序(預設=風險加權:對象中心性×陳舊天數,無鏈組後置)")

    p = sub.add_parser("recent", help="最近 N 天修改的筆記")
    p.add_argument("--days", type=int, default=7)

    sub.add_parser("stats", help="資料夾統計")

    p = sub.add_parser("export", help="輸出圖(mermaid/dot 文字;html=互動語意視圖)")
    p.add_argument("--format", choices=("mermaid", "dot", "html"), default="mermaid")
    p.add_argument("--folders", nargs="+", default=["Systems", "Projects", "Issues", "MOC"])
    p.add_argument("--output", default="graph.html", help="html 輸出檔(預設 graph.html)")
    p.add_argument("--standalone", action="store_true", help="html 內聯 cytoscape/marked(去 CDN,離線/防火牆可開)")

    # T1 寫側(行級手術,寫後自驗 atomic)
    p = sub.add_parser("set", help="改純量欄位(status/updated/created/type)")
    p.add_argument("note")
    p.add_argument("key")
    p.add_argument("value")
    p = sub.add_parser("append", help="list 欄位追加(verified_by/plan_refs/related/tags)")
    p.add_argument("note")
    p.add_argument("key")
    p.add_argument("value")
    p = sub.add_parser("new", help="依模板建檔")
    p.add_argument("type", choices=("system", "verification", "issue", "project"))
    p.add_argument("name")

    p = sub.add_parser("decision-supersede", help="T3 巢狀:翻盤一條決策(valid:false+superseded_by)")
    p.add_argument("note")
    p.add_argument("match", help="決策 content 子字串(多重命中 rc=2 列候選,防改錯項)或 \"#dN\" 精確定址(節點未 reindex 查無→rc=2)")
    p.add_argument("--by", required=True, help="被誰取代(superseded_by 值)")
    p.add_argument("--ended", help="失效日期 YYYY-MM-DD(選填)")

    p = sub.add_parser("decision-reindex", help="[M1/P2] 回填遷移:對無 id 決策從既有最大 id+1 接續編號(冪等);--all 批次套用全部決策節點(decision_refs 養成前置)")
    p.add_argument("note", nargs="?", help="單節點;省略需 --all")
    p.add_argument("--all", action="store_true", dest="reindex_all", help="批次套用到所有有 decisions 的節點(顯式指令)")

    p = sub.add_parser("rel-cascade", help="[M3/S5b] 連鎖判定帳本:confirm/prune 寫回、list 活動齡、resume 續展差集")
    p.add_argument("verb", choices=["confirm", "prune", "list", "resume"])
    p.add_argument("arg", nargs="?", help="confirm/prune=<鄰居節點>;resume=<cascade-id>;list 不吃")
    p.add_argument("--cascade-id", dest="rc_cid", help="confirm/prune 必填(帳本由 supersede 觸發端建立)")
    p.add_argument("--from", dest="rc_from", help="root 全域決策 id <節點rel>#d<N>(裸 dN 拒收;v1 全鏈同源)")
    p.add_argument("--edge", dest="rc_edge", choices=["verified_by", "plan_refs"], help="邊型(方向語意明確者)")
    p.add_argument("--by", dest="rc_by", choices=["ai", "human"], help="誰判的(ai 判的可抽查/翻案)")
    p.add_argument("--stale", dest="rc_stale", type=int, help="list:只列最後事件早於 N 天的 cascade(活動齡)")

    p = sub.add_parser("decision-add", help="T3 巢狀:新增一條 ADR 決策")
    p.add_argument("note")
    p.add_argument("content")
    p.add_argument("--decided", required=True, help="決策日期 YYYY-MM-DD")
    p.add_argument("--context", help="背景/痛點")
    p.add_argument("--why", help="why_chosen 為何選這個")

    p = sub.add_parser("archive", help="滾動歸檔老 Verification(單遍,移檔+path連結正規化)")
    p.add_argument("--days", type=int, default=180)
    p.add_argument("--apply", action="store_true", help="真執行(預設 dry-run)")















    args = ap.parse_args()

    # install/uninstall/update/bootstrap 不需要 Env(vault),先處理

    vault = args.vault or find_vault(Path.cwd())
    if vault is None or not vault.is_dir():
        print("ERROR: 找不到 vault (docs/*-knowledge),可用 --vault 指定", file=sys.stderr)
        return 2
    env = Env(vault)

    if args.cmd == "doctor":
        color = sys.stdout.isatty() and not args.ci
        return run_doctor(env, strict=(args.strict or args.ci), color=color, suggest=args.suggest, ci=args.ci)

    if args.cmd in ("links", "backlinks", "context", "map", "show") or \
       (args.cmd == "decisions" and not args.superseded):
        rel = env.find(getattr(args, "note", None) or "")
        if rel is None:
            print(f"ERROR: 找不到筆記: {args.note}", file=sys.stderr)
            return 2
        if args.cmd == "links":
            return cmd_links(env, rel)
        if args.cmd == "backlinks":
            return cmd_links(env, rel, reverse=True)
        if args.cmd == "context":
            return cmd_context(env, rel, brief=args.brief, recommend=args.recommend, top=args.ctx_top, min_score=args.ctx_min, as_json=args.ctx_json)
        if args.cmd == "map":
            return cmd_map(env, rel, args.depth)
        if args.cmd == "show":
            return cmd_show(env, rel, body_only=args.body_only)
        return cmd_decisions(env, rel)  # 無條件 fallback:新掛組內指令必須在此行前插 if 分支

    if args.cmd == "search":
        # 2026-07-11 轉正:相關性排序為預設(goldset 評測 §6 search 面全過);
        # --legacy 逃生;--regex 自動走舊路(候選語意不同,靜默、不印 fallback note)
        _use_ranked = not args.search_legacy and not args.regex
        if args.ranked and args.regex:
            print("(--ranked 不適用 --regex 模式,照舊輸出)", file=sys.stderr)
        return cmd_search(env, args.term, path_prefix=args.path_prefix,
                          regex=args.regex, files_only=args.files_only,
                          include_code=args.code, ranked=_use_ranked, top=args.top,
                          as_json=args.search_json, include_superseded=args.include_superseded)

    if args.cmd == "contracts":
        rel = None
        if args.note:
            rel = env.find(args.note)
            if rel is None:
                print(f"ERROR: 找不到筆記: {args.note}", file=sys.stderr)
                return 2
        return cmd_contracts(env, rel)

    if args.cmd == "lint":
        return cmd_lint(env, args.note)



        # capture-counts 已在 vault-free 段提前處理(見上)

    if args.cmd == "guard":
        if args.gcmd == "list":
            return cmd_guard_list(env, unbound_only=args.unbound)
        if args.gcmd == "scaffold":
            return cmd_guard_scaffold(env, args.node, args.invariant, args.method,
                                      args.type, args.claim, out_dir=args.out,
                                      template=args.template, klass=args.klass,
                                      platform=args.platform)
        if args.gcmd == "bind":
            return cmd_guard_bind(env, args.node, args.invariant, args.method,
                                  platform=args.platform)
        if args.gcmd == "audit":
            return cmd_guard_audit(env, args.node, args.invariant, args.model, args.date)
        if args.gcmd == "kill-add":
            return cmd_guard_kill_add(env, args.node, args.invariant, file=args.file,
                                      old=args.old, new=args.new, test=args.test,
                                      platform=args.gk_platform, note=args.note)
        if args.gcmd == "kill":
            return cmd_guard_kill(env, args.node, invariant_substr=args.invariant,
                                  platform_override=args.gk_platform,
                                  as_json=args.gk_json, keep_worktree=args.keep_worktree)
        if args.gcmd == "trace":
            return cmd_guard_trace(env, args.node)

    if args.cmd == "sync-verified-by":
        return cmd_sync_verified_by(env, apply=args.apply)

    if args.cmd == "decisions":
        return cmd_decisions(env, superseded=True)
    if args.cmd == "stale":
        return cmd_stale(env, match=args.match, candidate=args.candidate, legacy=args.stale_legacy)
    if args.cmd == "recent":
        return cmd_recent(env, args.days)
    if args.cmd == "stats":
        return cmd_stats(env)
    if args.cmd == "export":
        if args.format == "html":
            return cmd_export_html(env, args.output, standalone=args.standalone)
        return cmd_export(env, args.format, set(args.folders))


    # T1 寫側
    if args.cmd in ("set", "append"):
        rel = env.find(args.note)
        if rel is None:
            print(f"ERROR: 找不到筆記: {args.note}", file=sys.stderr)
            return 2
        try:
            if args.cmd == "set":
                return cmd_set(env, rel, args.key, args.value)
            return cmd_append(env, rel, args.key, args.value)
        except (ValueError, RuntimeError) as e:
            print(f"ERROR: {e}", file=sys.stderr)
            return 2
    if args.cmd == "new":
        import datetime
        try:
            return cmd_new(env, args.type, args.name, datetime.date.today().isoformat())
        except (ValueError, RuntimeError) as e:
            print(f"ERROR: {e}", file=sys.stderr)
            return 2
    if args.cmd == "rel-cascade":
        try:
            if args.verb in ("confirm", "prune"):
                missing = [f for f, v in (("<鄰居>", args.arg), ("--cascade-id", args.rc_cid),
                                          ("--from", args.rc_from), ("--edge", args.rc_edge),
                                          ("--by", args.rc_by)) if not v]
                if missing:
                    print(f"ERROR: rel-cascade {args.verb} 缺參數: {' '.join(missing)}", file=sys.stderr)
                    return 2
                return cmd_rel_cascade_write(env, args.verb, args.arg, args.rc_cid,
                                             args.rc_from, args.rc_edge, args.rc_by)
            if args.verb == "resume":
                if not args.arg:
                    print("ERROR: rel-cascade resume 需 <cascade-id>", file=sys.stderr)
                    return 2
                return cmd_rel_cascade_resume(env, args.arg)
            return cmd_rel_cascade_list(env, stale_days=args.rc_stale)
        except (ValueError, RuntimeError, OSError) as e:
            # [code-loop r1 B3] 含 OSError:磁碟滿/權限/TOCTOU 檔案消失/O_NOFOLLOW 拒 symlink
            #   ——帳本走檔案系統,IO 例外是本分支常態失敗面,裸 traceback 會破壞 rc=2 行式協議
            print(f"ERROR: {e}", file=sys.stderr)
            return 2

    if args.cmd == "decision-reindex" and getattr(args, "reindex_all", False):
        try:
            return cmd_decision_reindex(env, all_mode=True)
        except (ValueError, RuntimeError, OSError) as e:   # [code-loop r1 A] 寫檔面 IO 例外 → rc=2 非裸 traceback
            print(f"ERROR: {e}", file=sys.stderr)
            return 2

    if args.cmd in ("decision-supersede", "decision-add", "decision-reindex"):
        if args.cmd == "decision-reindex" and not args.note:
            print("ERROR: decision-reindex 需 <節點> 或 --all", file=sys.stderr)
            return 2
        rel = env.find(args.note)
        if rel is None:
            print(f"ERROR: 找不到筆記: {args.note}", file=sys.stderr)
            return 2
        try:
            # [M1/P2] 兩函式回 (rc, 全域決策id);dispatcher 解包,CLI 對外仍只回整數 rc
            #   (M4 [S1] 觸發端將在此用 decision_id 呼 cascade_surface——屆時包獨立 try/except)
            if args.cmd == "decision-reindex":
                return cmd_decision_reindex(env, rel)
            if args.cmd == "decision-supersede":
                rc, _decision_id = cmd_decision_supersede(env, rel, args.match, args.by, ended=args.ended)
                # [M4/S1] 觸發:supersede 成功→②建檔+③surfacing。②③同包獨立 try(不放上層
                #   atomic try 內——否則例外被 except 吞成 rc=2 違反 rc=0 合約,R8/T6)。
                #   輸出協議:supersede stdout 首行已印且逐字不變;cascade 面全走 stderr;
                #   失敗 fail-open(stderr 記 CASCADE-ERROR、rc 仍 0、補網 E2 兜底)。
                if rc == 0:
                    try:
                        if _decision_id:
                            _cid = rel_cascade_create(env, _decision_id, rel)
                            print(f"CASCADE {_cid} ROOT {_decision_id}", file=sys.stderr)
                            _n = cascade_surface(env, rel, _decision_id, stream=sys.stderr)
                            if not _n:
                                print("CASCADE-EMPTY 無 typed 連入鄰居(本次翻案無已知依賴面)", file=sys.stderr)
                        else:
                            print("CASCADE-SKIP 決策無 id(節點未 reindex),本次不開 cascade;補網 E2 兜底", file=sys.stderr)
                    except Exception as _e:   # fail-open:決策寫入已 atomic 完成,不回滾
                        print(f"CASCADE-ERROR {_e}", file=sys.stderr)
                return rc
            rc, _decision_id = cmd_decision_add(env, rel, args.content, args.decided,
                                                context=args.context, why=args.why)
            return rc
        except (ValueError, RuntimeError, OSError) as e:   # [code-loop 最終 delta A] 補 OSError:
            # 單節點 decision-supersede/add/reindex 皆走 atomic_write_verify 寫檔,IO 例外(磁碟滿/
            # 權限/BrokenPipe)本該 rc=2 非裸 traceback——與 --all/rel-cascade dispatcher 一致
            print(f"ERROR: {e}", file=sys.stderr)
            return 2
    if args.cmd == "archive":
        import datetime
        return cmd_archive(env, args.days, args.apply, datetime.date.today().isoformat())
    return 2


if __name__ == "__main__":
    sys.exit(main())
